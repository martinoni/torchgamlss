{
  "schema_version": 1,
  "case": "count_model_comparison",
  "description": "Weighted Poisson versus NBI count-regression comparison",
  "working_directory": "../..",
  "timeout_seconds": 300,
  "commands": {
    "r": [
      "{rscript}",
      "{case_dir}/run_r.R",
      "--data",
      "{case_dir}/data.csv",
      "--output-dir",
      "{output_dir}"
    ],
    "python": [
      "{python}",
      "{case_dir}/run_python.py",
      "--data",
      "{case_dir}/data.csv",
      "--output-dir",
      "{output_dir}"
    ]
  },
  "artifacts": [
    {
      "name": "model fits",
      "file": "fit.csv",
      "keys": [
        "model"
      ],
      "exact": [
        "converged"
      ],
      "numeric": {
        "global_deviance": {
          "atol": 2e-7,
          "rtol": 2e-7
        },
        "negative_log_likelihood": {
          "atol": 2e-7,
          "rtol": 2e-7
        },
        "effective_degrees_of_freedom": {
          "atol": 1e-12,
          "rtol": 1e-12
        },
        "residual_degrees_of_freedom": {
          "atol": 1e-12,
          "rtol": 1e-12
        },
        "observation_count": {
          "atol": 1e-12,
          "rtol": 1e-12
        },
        "effective_observation_count": {
          "atol": 1e-12,
          "rtol": 1e-12
        },
        "aic": {
          "atol": 2e-7,
          "rtol": 2e-7
        },
        "aicc": {
          "atol": 2e-7,
          "rtol": 2e-7
        },
        "bic": {
          "atol": 2e-7,
          "rtol": 2e-7
        },
        "pearson_dispersion": {
          "atol": 2e-7,
          "rtol": 2e-7
        }
      }
    },
    {
      "name": "AIC comparison",
      "file": "model_comparison.csv",
      "keys": [
        "model"
      ],
      "exact": [],
      "numeric": {
        "rank": {
          "atol": 1e-12,
          "rtol": 1e-12
        },
        "degrees_of_freedom": {
          "atol": 1e-12,
          "rtol": 1e-12
        },
        "global_deviance": {
          "atol": 2e-7,
          "rtol": 2e-7
        },
        "criterion": {
          "atol": 2e-7,
          "rtol": 2e-7
        },
        "delta": {
          "atol": 2e-7,
          "rtol": 2e-7
        },
        "weight": {
          "atol": 2e-8,
          "rtol": 2e-7
        }
      }
    },
    {
      "name": "coefficients",
      "file": "coefficients.csv",
      "keys": [
        "model",
        "parameter",
        "term"
      ],
      "exact": [],
      "numeric": {
        "estimate": {
          "atol": 2e-7,
          "rtol": 2e-7
        }
      }
    },
    {
      "name": "fitted moments",
      "file": "fitted.csv",
      "keys": [
        "model",
        "observation"
      ],
      "exact": [],
      "numeric": {
        "mu": {
          "atol": 2e-7,
          "rtol": 2e-7
        },
        "sigma": {
          "atol": 2e-7,
          "rtol": 2e-7
        },
        "variance": {
          "atol": 2e-7,
          "rtol": 2e-7
        }
      }
    },
    {
      "name": "response quantiles",
      "file": "quantiles.csv",
      "keys": [
        "model",
        "observation",
        "probability"
      ],
      "numeric_keys": {
        "probability": {
          "atol": 1e-14,
          "rtol": 1e-14
        }
      },
      "exact": [],
      "numeric": {
        "centile": {
          "atol": 1e-12,
          "rtol": 1e-12
        },
        "quantile": {
          "atol": 1e-12,
          "rtol": 1e-12
        }
      }
    },
    {
      "name": "randomized quantile residuals",
      "file": "residuals.csv",
      "keys": [
        "model",
        "observation"
      ],
      "exact": [],
      "numeric": {
        "uniform": {
          "atol": 1e-14,
          "rtol": 1e-14
        },
        "quantile_residual": {
          "atol": 2e-7,
          "rtol": 2e-7
        }
      }
    }
  ]
}
