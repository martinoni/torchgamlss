{
  "schema_version": 1,
  "case": "bccg_centile_curves",
  "description": "Smooth fetal-growth response centiles from a BCCG model",
  "working_directory": "../..",
  "timeout_seconds": 300,
  "commands": {
    "r": [
      "{rscript}",
      "{case_dir}/run_r.R",
      "--data",
      "{case_dir}/data.csv",
      "--output-dir",
      "{output_dir}"
    ],
    "python": [
      "{python}",
      "{case_dir}/run_python.py",
      "--data",
      "{case_dir}/data.csv",
      "--output-dir",
      "{output_dir}"
    ]
  },
  "artifacts": [
    {
      "name": "fit",
      "file": "fit.csv",
      "keys": [],
      "exact": [
        "converged"
      ],
      "numeric": {
        "global_deviance": {
          "atol": 2e-6,
          "rtol": 2e-6
        },
        "negative_log_likelihood": {
          "atol": 2e-6,
          "rtol": 2e-6
        },
        "effective_degrees_of_freedom": {
          "atol": 2e-6,
          "rtol": 2e-6
        },
        "residual_degrees_of_freedom": {
          "atol": 2e-6,
          "rtol": 2e-6
        },
        "observation_count": {
          "atol": 1e-12,
          "rtol": 1e-12
        },
        "effective_observation_count": {
          "atol": 1e-12,
          "rtol": 1e-12
        },
        "aic": {
          "atol": 2e-6,
          "rtol": 2e-6
        }
      }
    },
    {
      "name": "linear coefficients",
      "file": "coefficients.csv",
      "keys": [
        "parameter",
        "term"
      ],
      "exact": [],
      "numeric": {
        "estimate": {
          "atol": 2e-6,
          "rtol": 2e-6
        }
      }
    },
    {
      "name": "smooth summaries",
      "file": "smoothing.csv",
      "keys": [
        "parameter"
      ],
      "exact": [],
      "numeric": {
        "smoothing_parameter": {
          "atol": 1e-12,
          "rtol": 1e-12
        },
        "effective_degrees_of_freedom": {
          "atol": 2e-6,
          "rtol": 2e-6
        }
      }
    },
    {
      "name": "fitted parameters",
      "file": "fitted.csv",
      "keys": [
        "observation"
      ],
      "exact": [],
      "numeric": {
        "age": {
          "atol": 1e-12,
          "rtol": 1e-12
        },
        "mu": {
          "atol": 2e-6,
          "rtol": 2e-6
        },
        "sigma": {
          "atol": 2e-6,
          "rtol": 2e-6
        },
        "nu": {
          "atol": 2e-6,
          "rtol": 2e-6
        }
      }
    },
    {
      "name": "response centile curves",
      "file": "centiles.csv",
      "keys": [
        "grid_index",
        "centile"
      ],
      "numeric_keys": {
        "centile": {
          "atol": 1e-12,
          "rtol": 1e-12
        }
      },
      "exact": [],
      "numeric": {
        "age": {
          "atol": 1e-12,
          "rtol": 1e-12
        },
        "probability": {
          "atol": 1e-14,
          "rtol": 1e-14
        },
        "quantile": {
          "atol": 2e-6,
          "rtol": 2e-6
        }
      }
    },
    {
      "name": "quantile residuals",
      "file": "residuals.csv",
      "keys": [
        "observation"
      ],
      "exact": [],
      "numeric": {
        "age": {
          "atol": 1e-12,
          "rtol": 1e-12
        },
        "quantile_residual": {
          "atol": 2e-6,
          "rtol": 2e-6
        }
      }
    }
  ]
}
